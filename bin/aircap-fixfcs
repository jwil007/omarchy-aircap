#!/usr/bin/env python3
"""Mark trailing FCS in radiotap captures whose driver forgot to.

    aircap-fixfcs FILE.pcapng [FILE.pcapng...]

Some drivers (ath12k on WCN7850) deliver monitor-mode frames with the 4-byte
FCS still attached but without the radiotap "frame includes FCS" flag.
Wireshark then parses the FCS as frame body, and beacons and probes show
"Tag Length is longer than remaining payload" and similar errors.

For each radiotap frame whose last 4 bytes are a valid CRC-32 of the rest
of the 802.11 frame, this sets the FCS bit (0x10) in the radiotap Flags
field, in place. Frames without a valid trailing CRC, frames already
flagged, and frames whose radiotap header has no Flags field are left
alone, so it's a no-op on drivers that get this right. Prints
"<fixed> <radiotap frames>" per file.
"""

import struct
import sys
import zlib

LINKTYPE_RADIOTAP = 127
RADIOTAP_F_FCS = 0x10

# Alignment and size of radiotap fields before Flags (bit 1): only TSFT.
TSFT_ALIGN, TSFT_SIZE = 8, 8


def flags_offset(pkt):
    """Offset of the radiotap Flags byte in pkt, or None if absent."""
    if len(pkt) < 8 or pkt[0] != 0:
        return None
    rt_len = struct.unpack_from("<H", pkt, 2)[0]
    present = struct.unpack_from("<I", pkt, 4)[0]
    if not present & 0b10:
        return None
    # Skip extended presence words (bit 31 chains another word).
    off, word = 8, present
    while word & 0x80000000:
        if off + 4 > rt_len:
            return None
        word = struct.unpack_from("<I", pkt, off)[0]
        off += 4
    if present & 0b1:
        off = (off + TSFT_ALIGN - 1) // TSFT_ALIGN * TSFT_ALIGN + TSFT_SIZE
    return off if off < rt_len else None


def fix_file(path):
    fixed = total = 0
    linktypes = []
    with open(path, "r+b") as f:
        endian = "<"
        while True:
            head = f.read(8)
            if len(head) < 8:
                break
            start = f.tell() - 8
            btype = struct.unpack("<I", head[:4])[0]
            if btype == 0x0A0D0D0A:  # section header: learn byte order
                magic = f.read(4)
                endian = "<" if magic == b"\x4d\x3c\x2b\x1a" else ">"
                linktypes = []
            blen = struct.unpack(endian + "I", head[4:])[0]
            if blen < 12:
                raise ValueError(f"{path}: corrupt block at offset {start}")
            if btype == 1:  # interface description
                f.seek(start + 8)
                linktypes.append(struct.unpack(endian + "H", f.read(2))[0])
            elif btype == 6:  # enhanced packet
                f.seek(start + 8)
                iface, _, _, caplen, _ = struct.unpack(endian + "5I", f.read(20))
                if iface < len(linktypes) and linktypes[iface] == LINKTYPE_RADIOTAP:
                    pkt = f.read(caplen)
                    total += 1
                    pos = flags_offset(pkt)
                    if pos is not None and not pkt[pos] & RADIOTAP_F_FCS:
                        rt_len = struct.unpack_from("<H", pkt, 2)[0]
                        wlan = pkt[rt_len:]
                        if len(wlan) >= 14 and zlib.crc32(wlan[:-4]) == struct.unpack("<I", wlan[-4:])[0]:
                            f.seek(start + 28 + pos)
                            f.write(bytes([pkt[pos] | RADIOTAP_F_FCS]))
                            fixed += 1
            f.seek(start + blen)
    return fixed, total


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    rc = 0
    for path in sys.argv[1:]:
        try:
            fixed, total = fix_file(path)
            print(f"{fixed} {total} {path}")
        except (OSError, ValueError, struct.error) as e:
            print(f"aircap-fixfcs: {path}: {e}", file=sys.stderr)
            rc = 1
    return rc


if __name__ == "__main__":
    sys.exit(main())
